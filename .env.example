# ContextAI Environment Configuration
# Copy this file to .env and replace placeholder values with your actual configuration.

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Flask Security
FLASK_SECRET_KEY=replace_with_a_secure_random_key_in_production
FLASK_ENV=production

# Database Configuration
DATABASE_URL=sqlite:///contextai.db

# Context Window & Memory Management Settings
MAX_CONTEXT_TOKENS=4000
MAX_RECENT_MESSAGES=20
SUMMARY_TRIGGER_COUNT=10

